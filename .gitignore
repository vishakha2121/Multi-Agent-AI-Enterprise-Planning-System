# ============================================================
# Multi-Agent AI Enterprise Planning System (MAEPS)
# .gitignore — Complete Coverage
# ============================================================

# ────────────────────────────────────────────────────────────
# 1. DEPENDENCIES
# ────────────────────────────────────────────────────────────
node_modules/
node_modules
/.pnp
.pnp.js
bower_components/
jspm_packages/
.npm
.yarn/
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*
package-lock.json
yarn.lock
pnpm-lock.yaml

# ────────────────────────────────────────────────────────────
# 2. ENVIRONMENT VARIABLES & SECRETS
# ────────────────────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.env
!.env.example
config/secrets.json
secrets/
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
credentials.json
serviceAccountKey.json

# ────────────────────────────────────────────────────────────
# 3. BUILD OUTPUT / DIST
# ────────────────────────────────────────────────────────────
build/
dist/
out/
.next/
.nuxt/
.gatsby/
.cache/
.parcel-cache/
.turbo/
.vite/
public/build/
public/hot
frontend/build/
backend/dist/

# ────────────────────────────────────────────────────────────
# 4. LOGS & DEBUG
# ────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm/_logs/
*.log.gz
backend/logs/*.log
!backend/logs/.gitkeep
debug.log
error.log
combined.log
pids/
*.pid
*.seed
*.pid.lock

# ────────────────────────────────────────────────────────────
# 5. TESTING & COVERAGE
# ────────────────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov
.coveralls.yml
test-results/
junit.xml
cypress/videos/
cypress/screenshots/
cypress/downloads/
playwright-report/
test-results/

# ────────────────────────────────────────────────────────────
# 6. EDITOR & IDE FILES
# ────────────────────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.iml
*.ipr
*.iws
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
.history/
.ionide/

# ────────────────────────────────────────────────────────────
# 7. OS GENERATED FILES
# ────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon
.DocumentRevisions-V100
.fseventsd
.TemporaryItems
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump

# ────────────────────────────────────────────────────────────
# 8. DATABASE & MIGRATIONS
# ────────────────────────────────────────────────────────────
*.sqlite
*.sqlite3
*.db
*.db-journal
*.mdb
*.accdb
*.dbf
database/dumps/
database/backups/
database/*.dump
pgdata/
mongo-data/
.redis/

# ────────────────────────────────────────────────────────────
# 9. DOCKER
# ────────────────────────────────────────────────────────────
.docker/
docker-compose.override.yml
docker-compose.*.yml
!.dockerignore
docker-volumes/

# ────────────────────────────────────────────────────────────
# 10. NODE / NPM / YARN
# ────────────────────────────────────────────────────────────
.npmrc
.yarnrc
.yarnrc.yml
.node_repl_history
.node-version
.nvmrc
.eslintcache
.stylelintcache
